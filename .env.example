# ==============================================================================
# Anti-Algorithm Personal Hub - 环境变量配置模板
# 复制本文件为 .env 并填入你自己的配置（.env 已被 .gitignore 忽略，切勿提交）
# 如暂不配置 API Key，也可使用 --mock 或 --skip-llm 模式运行管道
# ==============================================================================

# OpenAI 兼容接口地址（支持 OpenAI、DeepSeek、OpenRouter、本地 Ollama 等）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini

# 可选：PandaScore 免费 API Key，用于自动抓取 CS2 S/A 级赛事赛程（未配置则自动跳过）
# 申请地址：https://www.pandascore.co/
# PANDASCORE_API_KEY=your-pandascore-token

# 可选：Webhook 多通道推送地址（留空则不启用对应通道）
# 飞书自定义机器人 Webhook：https://open.feishu.cn/open-apis/bot/v2/hook/xxx
WEBHOOK_FEISHU_URL=
# Discord 频道 Webhook：https://discord.com/api/webhooks/xxx/yyy
WEBHOOK_DISCORD_URL=
# Bark iOS 推送地址：https://api.day.app/你的Key
WEBHOOK_BARK_URL=
# 可选：用于手机端推送（如 Bark）跳转的看板地址（如 Tailscale IP 或局域网地址，例如 http://100.x.x.x:8765）
# 未配置时，Bark 推送会自动省略手机无法访问的 127.0.0.1 / localhost 本地链接
HUB_PUBLIC_URL=
# 通用自定义 Webhook（POST 发送标准 JSON：type / title / summary / items / timestamp）
WEBHOOK_CUSTOM_URL=
